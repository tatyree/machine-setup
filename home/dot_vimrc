function! ConvertAndSortAllToCommaSeparatedList()
    " Sort all lines in the file
    %sort u

    " Yank all lines in the file
    %y

    " Get the yanked lines into a list
    let lines = split(@", '\n')

    " Convert the sorted lines to a comma-separated list
    let comma_separated = join(lines, ', ')

    " Go to the end of the file and insert a blank line
    normal! Go

    " Insert the comma-separated list on a new line
    call append(line('.'), comma_separated)

    " Move the cursor to the newly inserted line
    normal! G

    " Copy the comma-separated list to the clipboard (for macOS)
    call system('echo '.shellescape(comma_separated).' | pbcopy')

    " Save the file after copying to the clipboard
    write
endfunction

command! ClSort call ConvertAndSortAllToCommaSeparatedList()

function! ConvertAndSortAllToSpaceSeparatedTwitterTags()
    " Sort all lines in the file
    %sort u

    " Yank all lines in the file
    %y

    " Get the yanked lines into a list
    let lines = split(@", '\n')

    " Function to camel-case each phrase
    function! CamelCasePhrase(phrase)
        let words = split(a:phrase, '\s\+')
        return '#' . tolower(words[0]) . join(map(slice(words, 1), 'toupper(strpart(v:val, 0, 1)) . tolower(strpart(v:val, 1))'), '')
    endfunction

    " Apply camel-case transformation and prefix with '#'
    let twitter_tags = map(lines, 'CamelCasePhrase(v:val)')

    " Convert the sorted lines to a space-separated list
    let space_separated = join(twitter_tags, ' ')

    " Go to the end of the file and insert a blank line
    normal! Go

    " Insert the space-separated list on a new line
    call append(line('.'), space_separated)

    " Move the cursor to the newly inserted line
    normal! G

    " Copy the space-separated list to the clipboard (for macOS)
    call system('echo '.shellescape(space_separated).' | pbcopy')

    " Save the file after copying to the clipboard
    write
endfunction

command! ClSortTags call ConvertAndSortAllToSpaceSeparatedTwitterTags()

