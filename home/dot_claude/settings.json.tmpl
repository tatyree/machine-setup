{
  "permissions": {
    "allow": [
      "Bash(mktemp:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(for f in:*)",
      "Bash(echo:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd'); model=$(echo \"$input\" | jq -r '.model.display_name'); style=$(echo \"$input\" | jq -r '.output_style.name // \"default\"'); dir=$(basename \"$cwd\"); git_info=\"\"; if git -C \"$cwd\" rev-parse --git-dir >/dev/null 2>&1; then branch=$(git -C \"$cwd\" -c core.useBuiltinFSMonitor=false rev-parse --abbrev-ref HEAD 2>/dev/null); if [ -n \"$branch\" ]; then if ! git -C \"$cwd\" -c core.useBuiltinFSMonitor=false diff --quiet 2>/dev/null || ! git -C \"$cwd\" -c core.useBuiltinFSMonitor=false diff --cached --quiet 2>/dev/null; then git_info=\" on $(printf '\\033[31m')$branch$(printf '\\033[0m')*\"; else git_info=\" on $(printf '\\033[32m')$branch$(printf '\\033[0m')\"; fi; fi; fi; style_info=\"\"; if [ \"$style\" != \"default\" ]; then style_info=\" [$(printf '\\033[36m')$style$(printf '\\033[0m')]\"; fi; printf \"$(printf '\\033[35m')%s$(printf '\\033[0m') in $(printf '\\033[34m')%s$(printf '\\033[0m')%s%s\" \"$model\" \"$dir\" \"$git_info\" \"$style_info\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(wrangler deploy:*) — never deploy directly; Cloudflare GitHub integration handles deploys on push",
      "Bash(npm version *) followed by push outside the documented release flow — confirm build passes first per CLAUDE.md release procedure"
    ]{{- $extra := joinPath .chezmoi.homeDir ".config/machine-setup/extra/claude-automode-environment.json" }}
{{- if stat $extra }},
    "environment": {{ output "cat" $extra | trim }}
{{- end }}
  }
}
